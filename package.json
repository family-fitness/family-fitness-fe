{
  "name": "family-fitness-fe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:assets && npm run check:mocks && npm run check:lib",
    "prepare": "husky",
    "check:mocks": "tsx scripts/check-mocks.mts",
    "check:lib": "tsx scripts/check-lib.mts",
    "shot": "node scripts/screenshot.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "api:types": "openapi-typescript http://localhost:8080/v3/api-docs -o src/lib/api/schema.ts",
    "check:assets": "node scripts/check-assets.mjs",
    "check:screens": "node scripts/check-screens.mjs",
    "check:onboarding": "node scripts/check-onboarding.mjs",
    "icons": "node scripts/make-icons.mjs",
    "check:clicks": "node scripts/check-clicks.mjs",
    "check:down": "node scripts/check-backend-down.mjs",
    "check:play": "node scripts/check-play.mjs",
    "check:loop": "node scripts/check-loop.mjs",
    "check:journey": "node scripts/check-journey.mjs",
    "check:nowebgl": "node scripts/check-no-webgl.mjs",
    "assets:list": "node scripts/list-assets.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "description": "우리가족 체력키움 프론트엔드",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "ajv": "^6.12.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
