# 백엔드 주소. Next 의 rewrites 가 /api/v1/* 를 여기로 넘긴다
BACKEND_ORIGIN=http://localhost:8080

# MSW 가짜 서버 스위치
#   enabled  → 브라우저에서 요청을 가로채 목 데이터를 돌려준다 (백엔드 없이 개발)
#   그 외    → 실제 백엔드로 간다
# 빌드할 때 값으로 정해진다 — next start 를 띄울 때 넣어도 바뀌지 않는다.
# 운영 빌드에서는 이 줄을 지우거나 비워 둔다. enabled 로 빌드하면 목 코드와 개발용 계정이 번들에 들어간다
NEXT_PUBLIC_API_MOCKING=enabled

# 구글 로그인 클라이언트 ID. 인가 요청은 프론트가 하고 코드 교환은 백엔드가 한다.
# 시크릿은 백엔드에만 둔다 — 브라우저에 내려오면 안 된다
# 이 값도 빌드할 때 박힌다. 비워 두고 빌드하면 구글 단추가 눌리지 않는다.
# 개발 서버, 목 빌드, 아래 NEXT_PUBLIC_DEV_LOGIN=enabled 빌드에서는 구글 대신 새 계정으로 들어간다
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 개발 로그인 단추(시드 계정)를 빌드에 싣는다 — 로컬 백엔드에 붙여 보는 빌드에서만 enabled.
# 운영 빌드에는 두지 않는다(누구나 같은 개발 계정으로 들어가 남의 가족을 보게 된다)
NEXT_PUBLIC_DEV_LOGIN=
